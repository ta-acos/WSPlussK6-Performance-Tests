    "endurance_test": { "addRules": { "http_req_duration": ["p(99)<9000"] } }
  },
  "environments": {
    "dev": { "multipliers": { "http_req_duration.p95": 1.3 } },
    "autotest": {},
    "prod": { "multipliers": { "http_req_duration.p95": 0.9, "http_req_duration.p99": 0.9 } }
  }
