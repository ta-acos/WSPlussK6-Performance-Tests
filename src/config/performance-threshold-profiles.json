{
  "_doc": "Scenario and environment modifiers for performance thresholds. Multipliers apply to numeric targets in canonical thresholds.",
  "scenarios": {
    "smoke_test": { "multipliers": { "http_req_duration.p95": 1.5 }, "disabledStats": ["p(99)"] },
